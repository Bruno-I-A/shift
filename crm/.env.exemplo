# Variáveis do CRM. Em produção ficam no Easypanel (Ambiente do serviço);
# em desenvolvimento, num .env.local ao lado deste arquivo.

# --- Banco ---------------------------------------------------------------------
# O papel da APLICAÇÃO (shift_crm_app), nunca o dono nem o usuário do Easypanel.
# O app confere e se recusa a operar com superusuário ou com o dono do schema.
DATABASE_URL=postgres://shift_crm_app:SENHA@HOST:5432/shift_crm

# O dono das estruturas (shift_crm_owner). Usado só pelas migrações, no boot.
# Sem ela o app sobe, mas não migra — /api/saude avisa.
DATABASE_URL_MIGRACAO=postgres://shift_crm_owner:SENHA@HOST:5432/shift_crm

# As duas acima saem prontas de: node scripts/configurar-banco.mjs

# BANCO_SSL=sim            # só se o Postgres exigir TLS
# BANCO_MAX_CONEXOES=5

# Só em desenvolvimento com `npm run banco:local` (PGlite, um usuário só):
# BANCO_PAPEL=shift_crm_app
# BANCO_MAX_CONEXOES=1

# --- Login ---------------------------------------------------------------------
ADMIN_EMAIL=voce@exemplo.com
# As duas abaixo saem de: npm run configurar-login
ADMIN_SENHA_HASH=scrypt:32768:8:1:SAL:HASH
SESSAO_SEGREDO=GERADO_PELO_SCRIPT

# --- Endereço ------------------------------------------------------------------
# Usado para montar o endereço do MCP mostrado na tela de Agentes.
APP_URL=https://crm.shiftsys.com.br

# --- Leads do site -----------------------------------------------------------
# De onde /api/leads aceita envio de navegador. Padrão: os dois endereços do site.
# ORIGENS_SITE=https://shiftsys.com.br,https://www.shiftsys.com.br

# --- Agente de atendimento no WhatsApp ---------------------------------------
# Desligado por padrão. Ative só depois de configurar o app e o número na Meta.
# WHATSAPP_ATIVO=sim
# Meta for Developers > seu app > WhatsApp > Configuração da API.
# Nunca use token temporário em produção.
# WHATSAPP_META_PHONE_NUMBER_ID=ID_DO_NUMERO
# WHATSAPP_META_ACCESS_TOKEN=TOKEN_PERMANENTE_DO_SISTEMA
# Modelos (falar fora das 24 horas): o ID da conta do WhatsApp Business, que
# aparece no Gerenciador do WhatsApp e em Meta for Developers > WhatsApp >
# Configuração da API. O token acima precisa também da permissão
# whatsapp_business_management para listar e criar modelos.
# WHATSAPP_META_WABA_ID=ID_DA_CONTA_WHATSAPP_BUSINESS
# Versão da Graph API exibida no painel da Meta, ex.: v24.0.
# WHATSAPP_META_GRAPH_VERSION=v24.0
# Meta for Developers > WhatsApp > Configuração: escolha este valor no webhook.
# WHATSAPP_META_VERIFY_TOKEN=SEGREDO_ALEATORIO_LONGO
# Meta for Developers > Configurações > Básico: App Secret. Assina os webhooks.
# WHATSAPP_META_APP_SECRET=APP_SECRET
# Chave criada no Console da Anthropic para este serviço.
# ANTHROPIC_API_KEY=CHAVE_DA_API_ANTHROPIC
# Sem esta variável, usa Haiku 5.5. Um valor explícito continua tendo prioridade.
# Para trocar o Sonnet do ambiente atual pelo modelo mais econômico:
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Instagram (publicação agendada) -------------------------------------------
# Meta for Developers > app > Instagram > Configuração da API com login do
# Instagram > Configurações do login comercial: o ID e a chave secreta do app
# do INSTAGRAM (não os do app da Meta). Cadastre lá o endereço de retorno:
# https://crm.shiftsys.com.br/api/instagram/retorno
# INSTAGRAM_APP_ID=ID_DO_APP_DO_INSTAGRAM
# INSTAGRAM_APP_SECRET=CHAVE_SECRETA_DO_APP_DO_INSTAGRAM
# Sem esta variável, usa v26.0.
# INSTAGRAM_GRAPH_VERSION=v26.0
# Onde ficam vídeos e fotos até a Meta buscá-los. Na imagem já é /app/midia,
# que precisa ser um volume. Em desenvolvimento, padrão: ./.midia-local
# PASTA_MIDIA=/app/midia

# --- Instagram Direct (atendimento, independente do WhatsApp) -------------------
# Desligado por padrão; mantenha Anthropic e as variáveis do Instagram acima.
# INSTAGRAM_DIRECT_ATIVO=sim
# Mesmo valor no campo de verificação do webhook da Meta (não é access token).
# Callback: https://crm.shiftsys.com.br/api/instagram/webhook
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=SEGREDO_ALEATORIO_LONGO
# Opcional: chave de assinatura do app onde o webhook foi cadastrado,
# se ela for diferente da chave do login do Instagram. Padrão INSTAGRAM_APP_SECRET.
# INSTAGRAM_WEBHOOK_APP_SECRET=APP_SECRET_DO_WEBHOOK
# Depois do deploy, reconecte o Instagram para autorizar mensagens e clique
# Conectar Direct em /instagram/direct. Guia: docs/instagram-direct.md.
